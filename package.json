{
  "name": "goobercord",
  "version": "1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --var COMMIT_SHA:$(git rev-parse --short HEAD)",
    "db:migrate:local": "wrangler d1 migrations apply wempo-forum-data --local",
    "db:import:forum:local": "wrangler d1 execute wempo-forum-data --local --file migrations/import-from-forum.sql",
    "db:migrate:remote": "wrangler d1 migrations apply wempo-forum-data --remote",
    "test": "node --test"
  },
  "devDependencies": {
    "wrangler": "4.156.0"
  }
}
